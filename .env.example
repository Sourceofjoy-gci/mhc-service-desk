# =============================================================================
# MHC Unified e-Ticketing — Environment Configuration
# Copy to .env and adjust. NEVER commit .env to source control.
# =============================================================================

# ---------- General ----------
PROJECT_NAME=mhc-ticketing
ENVIRONMENT=development
DOMAIN=localhost
PUBLIC_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string-please-do-it
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mhc
POSTGRES_USER=mhc
POSTGRES_PASSWORD=change-me-postgres

# ---------- Keycloak (OIDC) ----------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
KEYCLOAK_REALM=mhc
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_CLIENT_ID=mhc-frontend
KEYCLOAK_CLIENT_SECRET=change-me-client-secret
KEYCLOAK_BOOTSTRAP=true

# ---------- RabbitMQ (Celery broker) ----------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=mhc
RABBITMQ_PASSWORD=change-me-rabbit
RABBITMQ_VHOST=/

# ---------- Redis / Valkey (cache + lock) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://mhc:change-me-redis@redis:6379/0

# ---------- MinIO (object storage) ----------
MINIO_ROOT_USER=change-me-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_BUCKET=mhc-attachments
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_INTERNAL_URL=http://minio:9000

# ---------- ClamAV (malware scanning) ----------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---------- Observability ----------
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---------- Backup ----------
BACKUP_ENCRYPTION_KEY=change-me-32-byte-fernet-key
