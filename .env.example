# =============================================================================
# MHC Unified e-Ticketing — Environment Configuration
# Copy to .env and adjust. NEVER commit .env to source control.
# =============================================================================

# ---------- General ----------
PROJECT_NAME=mhc-ticketing
ENVIRONMENT=development
DOMAIN=localhost
FILES_DOMAIN=files.localhost
# Exact browser origins trusted for OIDC redirects. Set LAN_BASE_URL to this
# host's current private address; set PUBLIC_BASE_URL to the HTTPS public
# origin when publishing the application.
LOCAL_BASE_URL=http://localhost:5173
LAN_BASE_URL=http://192.168.1.50:5173
PUBLIC_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
BACKEND_PORT=8000
# Opt in with 1 only when deliberately bypassing Keycloak locally.
VITE_DEV_AUTH=0
# Keep true unless local development runs behind a TLS-inspecting proxy.
NPM_CONFIG_STRICT_SSL=true

# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string-please-do-it
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mhc
POSTGRES_USER=mhc
POSTGRES_PASSWORD=change-me-postgres

# ---------- Keycloak (OIDC) ----------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
KEYCLOAK_REALM=mhc
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:5173
KEYCLOAK_ALLOWED_ISSUERS=http://localhost:5173/realms/mhc,http://192.168.1.50:5173/realms/mhc
KEYCLOAK_CLIENT_ID=mhc-frontend
KEYCLOAK_CLIENT_SECRET=change-me-client-secret
KEYCLOAK_BOOTSTRAP=true
# Internal Docker targets used by the development frontend's same-origin proxy.
API_PROXY_TARGET=http://backend:8000
KEYCLOAK_PROXY_TARGET=http://keycloak:8080

# ---------- RabbitMQ (Celery broker) ----------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=mhc
RABBITMQ_PASSWORD=change-me-rabbit
RABBITMQ_VHOST=/

# ---------- Redis / Valkey (cache + lock) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://mhc:change-me-redis@redis:6379/0

# ---------- MinIO (object storage) ----------
MINIO_ROOT_USER=change-me-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_BUCKET=mhc-attachments
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_INTERNAL_URL=http://minio:9000

# ---------- ClamAV (malware scanning) ----------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---------- Observability ----------
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---------- Backup ----------
BACKUP_ENCRYPTION_KEY=change-me-32-byte-fernet-key

# ---------- Channel trust boundaries ----------
# HMAC secret shared only with the normalized internal email adapter.
EMAIL_WEBHOOK_SECRET=change-me-email-webhook-hmac-secret
# Meta App Secret and webhook verification token for WhatsApp Cloud API.
WHATSAPP_APP_SECRET=change-me-meta-app-secret
WHATSAPP_VERIFY_TOKEN=change-me-meta-webhook-verification-token
WHATSAPP_PROVIDER=mock
# Signed webhook messages outside this window are rejected.
CHANNEL_WEBHOOK_MAX_AGE_SECONDS=300
TICKET_REFERENCE_PREFIX_OPERATIONAL=O
TICKET_REFERENCE_PREFIX_IT=I
